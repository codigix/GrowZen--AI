# Cross-cutting rules for the whole monorepo (backend/, frontend/, google_trends/).
# Each subproject also has its own .gitignore for build output specific to it.

# Python virtual environments, any name/depth (.venv, .venv2, venv, etc.)
.venv/
.venv*/
venv/
**/.venv/
**/.venv*/
**/venv/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
*.egg-info/

# Node
node_modules/
**/node_modules/
dist/
**/dist/

# Environment files: never commit secrets. .env.example files are templates and stay tracked.
.env
.env.*
!.env.example

# Databases and generated reports
*.db
*.db-shm
*.db-wal
*.sqlite3
reports/
**/reports/

# Uploaded files (blog featured images, ...): user content, not source
backend/uploads/

# OS / editor junk
.DS_Store
Thumbs.db
*.log

# HTML website deployment targets and credentials (server side only; see docs/html-site-deployment.md)
backend/html_deploy.json
