# Google Trends keyword planner - standalone service config
GOOGLE_TRENDS_DEFAULT_COUNTRY=IN
GOOGLE_TRENDS_DEFAULT_LANGUAGE=en-IN
GOOGLE_TRENDS_TZ_OFFSET_MINUTES=330
GOOGLE_TRENDS_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_TRENDS_MAX_RETRIES=3
GOOGLE_TRENDS_RETRY_BACKOFF_SECONDS=5
GOOGLE_TRENDS_CACHE_TTL_SECONDS=1800
GOOGLE_TRENDS_MIN_REQUEST_INTERVAL_SECONDS=4.0
GOOGLE_TRENDS_MAX_EXPANSION_CANDIDATES=8
GOOGLE_TRENDS_CORS_ORIGINS=*
