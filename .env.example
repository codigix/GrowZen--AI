# One shared .env for the whole monorepo (backend, frontend, google_trends all read this file).
# Copy this to .env and fill in. Everything optional is marked; without it the matching feature
# uses sample data (labelled "sample") or stays off.

# ===== backend (FastAPI, port 8000) =====

# Service
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000      # where this API is reachable (Google OAuth callback)
FRONTEND_URL=http://localhost:3100                  # the SEO frontend (frontend/)
CORS_ORIGINS=http://localhost:3100

# Own PostgreSQL database in prod (create it first: CREATE DATABASE seo_platform_db;); SQLite for local dev
DATABASE_URL=postgresql+psycopg://seo:change-me@localhost:5432/seo_platform_db

# Login: the platform's own accounts. SECRET_KEY signs the session cookie (any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))").
# On the first start, when there are no users yet, an admin is created from ADMIN_EMAIL / ADMIN_PASSWORD.
SECRET_KEY=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
COOKIE_SECURE=false                                 # true behind HTTPS

# Optional: also accept the CRM's session cookie. Must equal JWT_SECRET in server/.env of the CRM.
CRM_JWT_SECRET=
CRM_API_URL=http://127.0.0.1:5002/api      # use 127.0.0.1, not localhost (Windows tries IPv6 first). Used to look up the user's name/role/department
ALLOWED_DEPARTMENTS=testing,admin,management,seo
ALLOWED_ROLES=admin,super admin,tester

# Encrypts stored Google refresh tokens. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Business Profile (OAuth client from an approved Google Cloud project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PageSpeed Insights API key (free, 25,000 audits/day) - needed for technical audits
PAGESPEED_API_KEY=
# Places API (New) key - find a business on Google Maps from an email or name (read-only)
GOOGLE_PLACES_API_KEY=
# OpenStreetMap (no key): business-name suggestions and location details while onboarding. The typed name is sent
# to photon.komoot.io and nominatim.openstreetmap.org. Set to false to turn it off.
OSM_LOOKUP_ENABLED=true

# Onboarding mailbox (IMAP) - e.g. onboarding@codigixinfotech.com
INTAKE_IMAP_HOST=
INTAKE_IMAP_PORT=993
INTAKE_IMAP_USER=
INTAKE_IMAP_PASSWORD=
INTAKE_IMAP_FOLDER=INBOX
INTAKE_ALLOWED_SENDERS=codigixinfotech.com   # addresses or domains whose emails are accepted
INTAKE_WEBHOOK_TOKEN=                        # optional: for forwarding services that POST emails

# Email out (optional): reports to clients, "missing details" replies to sales
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI (deepseek | openai | gemini) - extraction, replies, posts, reports
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Extra engines for the GEO / AEO tracker (optional)
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# DataForSEO (optional, paid): live rank grids, keyword volume, backlinks
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Scheduler (run on ONE instance only)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=300

# Lighthouse audits (/api/v1/lighthouse/...): full Lighthouse reports for any URL or a whole sitemap.
# Two engines; either is enough. PageSpeed Insights uses PAGESPEED_API_KEY above. The local engine
# needs Node.js + `npm install -g lighthouse` + Chrome or Edge. A failed PageSpeed run falls back to local.
LIGHTHOUSE_PAGESPEED_ENABLED=true
LIGHTHOUSE_LOCAL_ENABLED=true
LIGHTHOUSE_TIMEOUT_SECONDS=180
LIGHTHOUSE_MAX_CONCURRENT_LOCAL=2            # each one is a real Chrome process
LIGHTHOUSE_MAX_CONCURRENT_PAGESPEED=8
LIGHTHOUSE_REPORTS_DIR=./reports/lighthouse  # raw JSON / HTML reports (keep it on persistent disk)
LIGHTHOUSE_RATE_LIMIT_PER_MINUTE=10          # new audits per user
SERPER_API_KEY=

# Google Trends keyword planner proxy (see google_trends/ below for the service itself)
GOOGLE_TRENDS_BASE_URL=http://localhost:8100
GOOGLE_TRENDS_TIMEOUT_SECONDS=90.0

# ===== frontend (Vite, port 3100) =====

# Address of the SEO backend API
VITE_API_URL=http://localhost:8000/api/v1

# ===== google_trends (standalone keyword-trends microservice, port 8100) =====

GOOGLE_TRENDS_DEFAULT_COUNTRY=IN
GOOGLE_TRENDS_DEFAULT_LANGUAGE=en-IN
GOOGLE_TRENDS_TZ_OFFSET_MINUTES=330
GOOGLE_TRENDS_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_TRENDS_MAX_RETRIES=3
GOOGLE_TRENDS_RETRY_BACKOFF_SECONDS=5
GOOGLE_TRENDS_CACHE_TTL_SECONDS=1800
GOOGLE_TRENDS_MIN_REQUEST_INTERVAL_SECONDS=4.0
GOOGLE_TRENDS_MAX_EXPANSION_CANDIDATES=8
GOOGLE_TRENDS_CORS_ORIGINS=*
